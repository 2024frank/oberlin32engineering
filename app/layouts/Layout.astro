---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pageMeta, pageUrl, type PageId } from '../lib/page-meta';
import '../../src/assets/css/site.css';

interface Props { pageId: PageId }
const { pageId } = Astro.props;
const meta = pageMeta[pageId];
const canonical = new URL(pageUrl(pageId), Astro.site);
const domain = 'https://www.oberlin32engineeringsociety.com';
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'StudentOrganization'],
  name: 'Oberlin 3-2 Engineering Society',
  alternateName: ['Oberlin College 3-2 Engineering Society', 'Oberlin Engineering Society', 'Oberlin 3+2 Engineering Society'],
  url: domain,
  logo: `${domain}/assets/images/iglogo.png`,
  image: `${domain}/assets/images/og-cover.png`,
  foundingDate: '2026',
  sameAs: ['https://www.instagram.com/oberlin32engineering/'],
  description: 'A student group for Oberlin students interested in engineering projects, the 3-2 pathway, workshops, and events.',
  location: { '@type': 'Place', name: 'Oberlin College', address: { '@type': 'PostalAddress', addressLocality: 'Oberlin', addressRegion: 'OH', postalCode: '44074', addressCountry: 'US' } },
};
const pathwaySchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: "What is Oberlin College's 3-2 engineering program?", acceptedAnswer: { '@type': 'Answer', text: 'Oberlin describes it as three years of liberal-arts and pre-engineering study followed by engineering study at an affiliated school. Verify current requirements with Oberlin advising and the intended partner.' } },
    { '@type': 'Question', name: 'Do you have to commit to 3-2 to join the society?', acceptedAnswer: { '@type': 'Answer', text: 'No. Any current Oberlin student interested in engineering may join, and no prior technical experience is required.' } },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#161317">
    <meta name="color-scheme" content="light">
    <meta name="description" content={meta.description}>
    <meta name="author" content="Oberlin 3-2 Engineering Society">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta name="robots" content={meta.robots ?? 'index, follow'}>
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Oberlin 3-2 Engineering Society">
    <meta property="og:title" content={meta.title}>
    <meta property="og:description" content={meta.description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={`${domain}/assets/images/og-cover.png`}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={meta.title}>
    <meta name="twitter:description" content={meta.description}>
    <meta name="twitter:image" content={`${domain}/assets/images/og-cover.png`}>
    <title>{meta.title}</title>
    <link rel="icon" href="/assets/images/iglogo.png" type="image/png">
    <link rel="apple-touch-icon" href="/assets/images/icon-192.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="alternate" type="application/rss+xml" title="Oberlin 3-2 Engineering Society updates" href="/feed.xml">
    <link rel="preload" href="/assets/images/iglogo-384.webp" as="image" type="image/webp">
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script is:inline src="/assets/js/runtime-config.js"></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    {pageId === 'pathway' && <script is:inline type="application/ld+json" set:html={JSON.stringify(pathwaySchema)}></script>}
  </head>
  <body class={`page page--${pageId}`} data-page={pageId}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header pageId={pageId} />
    <main id="main-content"><slot /></main>
    <Footer />
    <div class="toast-region" data-toast-region aria-live="polite" aria-atomic="true"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
