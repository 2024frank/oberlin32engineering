---
import type { PageId } from '../lib/page-meta';

interface Props { pageId: PageId }
const { pageId } = Astro.props;
const links = [
  ['index', 'Home'],
  ['about', 'About'],
  ['pathway', '3-2 Pathway'],
  ['projects', 'Projects'],
  ['events', 'Events'],
  ['resources', 'Resources'],
  ['leadership', 'Team'],
] as const;
const mobileLinks = [
  ['index', 'Home', 'Society overview'],
  ['about', 'About', 'Purpose and first-year plan'],
  ['pathway', '3-2 Pathway', 'Planning steps and partner links'],
  ['projects', 'Projects', 'Selection process and technical areas'],
  ['events', 'Events', 'Schedule and event-interest form'],
  ['resources', 'Resources', '3-2 and technical source pages'],
  ['leadership', 'Team', 'Officers and open positions'],
  ['contact', 'Contact', 'Questions and collaboration requests'],
] as const;
---
<div class="announcement" data-announcement>
  <div class="container announcement__inner">
    <p data-site-announcement>Founding in 2026–27.</p>
    <a data-announcement-link href="/join">Join the society <span aria-hidden="true">→</span></a>
  </div>
</div>
<header class="site-header" data-header>
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label="Oberlin 3-2 Engineering Society home">
      <img src="/assets/images/iglogo-384.webp" alt="" width="384" height="384">
      <span><strong>Oberlin 3-2</strong><small>Engineering Society</small></span>
    </a>
    <nav class="primary-nav" aria-label="Primary navigation">
      {links.map(([id, label]) => <a href={id === 'index' ? '/' : `/${id}`} class:list={{ active: pageId === id }} aria-current={pageId === id ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="button button--small button--primary desktop-join" href="/join" class:list={{ active: pageId === 'join' }} aria-current={pageId === 'join' ? 'page' : undefined}>Join</a>
      <button class="menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">Open navigation</span><i></i><i></i><i></i>
      </button>
    </div>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <nav class="container" aria-label="Mobile navigation">
    {mobileLinks.map(([id, label, description]) => <a href={id === 'index' ? '/' : `/${id}`} class:list={{ active: pageId === id }} aria-current={pageId === id ? 'page' : undefined}>{label} <span>{description}</span></a>)}
    <a class="button button--primary" href="/join" aria-current={pageId === 'join' ? 'page' : undefined}>Submit membership interest</a>
  </nav>
</div>
