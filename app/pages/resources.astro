---
import Layout from '../layouts/Layout.astro';
---
<Layout pageId="resources">
<section class="page-hero">
  <div class="container page-hero__grid">
    <div><span class="eyebrow">Resource library</span><h1>Engineering and 3-2 resources.</h1><p class="page-hero__lead">Find Oberlin program pages, partner requirements, research opportunities, career services, and project references.</p></div>
    <div class="page-hero__side"><figure class="page-hero__figure"><img src="assets/images/photos/bench-multimeter.jpg" width="1200" height="960" loading="eager" fetchpriority="high" decoding="async" alt="A multimeter and test leads on an electronics bench"></figure><aside class="page-hero__aside"><strong>Check dates on program pages</strong><p>The review date shows when this directory was checked. Use the linked source for deadlines and requirements.</p></aside></div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading"><div><span class="eyebrow">Find a resource</span><h2>Search the library.</h2></div><p>Search titles, descriptions, or source names, or choose a topic filter.</p></div>
    <label class="search-field"><span class="sr-only">Search resources</span><input type="search" name="resource_search" data-resource-search autocomplete="off" placeholder="Search by topic or source…"></label>
    <div class="filters" data-filter-group data-filter-target="#resource-grid"><button class="filter-button active" type="button" data-filter="all">All</button><button class="filter-button" type="button" data-filter="3-2 planning">3-2 planning</button><button class="filter-button" type="button" data-filter="partner school">Partner schools</button><button class="filter-button" type="button" data-filter="careers">Careers</button><button class="filter-button" type="button" data-filter="research">Research</button><button class="filter-button" type="button" data-filter="project skills">Project skills</button></div>
    <div class="card-grid" id="resource-grid" data-resource-grid aria-live="polite"><div class="empty-state"><h3>Loading resources…</h3><p>Preparing the library.</p></div></div>
  </div>
</section>

<section class="section section--soft">
  <div class="container split split--center">
    <div><span class="eyebrow">Corrections</span><h2>Found a broken or outdated link?</h2><p>Send the page title and the correct source so the library can be updated.</p></div>
    <div class="page-hero__actions"><a class="button button--primary" href="contact">Report a resource problem</a></div>
  </div>
</section>
</Layout>
