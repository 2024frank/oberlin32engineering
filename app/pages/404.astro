---
import Layout from '../layouts/Layout.astro';
---
<Layout pageId="404">
<section class="page-hero">
  <div class="container page-hero__grid">
    <div><span class="eyebrow">404</span><h1>That page is not here.</h1><p class="page-hero__lead">The link may be out of date or mistyped. Here is where to go instead.</p><div class="page-hero__actions"><a class="button button--primary" href="/">Go to the homepage</a><a class="button button--secondary" href="contact">Report a broken link</a></div></div>
    <div class="page-hero__side"><figure class="page-hero__figure"><img src="/assets/images/photos/tool-pegboard.jpg" width="1200" height="960" loading="eager" fetchpriority="high" decoding="async" alt="A pegboard with empty pegs"></figure><aside class="page-hero__aside"><strong>Where to go instead</strong><p><a class="text-link" href="/pathway">3-2 guide</a><br><a class="text-link" href="/projects">Projects</a><br><a class="text-link" href="/events">Events</a><br><a class="text-link" href="/resources">Resources</a></p></aside></div>
  </div>
</section>
</Layout>
